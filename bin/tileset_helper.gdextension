[configuration]

entry_symbol = "tileset_helper_library_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]

# Editor-only tool: the `editor` feature tag exists only while the Godot editor runs,
# never in an exported game, so these libraries are never bundled into a build. We point
# the editor at the template_debug build (the editor is itself a debug build).
windows.editor.x86_64 = "res://bin/libtileset_helper.windows.template_debug.x86_64.dll"
linux.editor.x86_64 = "res://bin/libtileset_helper.linux.template_debug.x86_64.so"
macos.editor = "res://bin/libtileset_helper.macos.template_debug.framework"
