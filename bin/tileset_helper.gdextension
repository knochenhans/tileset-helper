[configuration]

entry_symbol = "tileset_helper_library_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://bin/libtileset_helper.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libtileset_helper.windows.template_release.x86_64.dll"

linux.debug.x86_64 = "res://bin/libtileset_helper.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libtileset_helper.linux.template_release.x86_64.so"

macos.debug = "res://bin/libtileset_helper.macos.template_debug.framework"
macos.release = "res://bin/libtileset_helper.macos.template_release.framework"
